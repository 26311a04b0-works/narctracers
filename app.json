{
  "expo": {
    "name": "NarcTracers",
    "slug": "narctracers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "narctracers",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NarcTracers needs camera access to capture evidence photos of field drug tests.",
        "NSMicrophoneUsageDescription": "NarcTracers needs microphone access to record voice notes for test observations."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-camera"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
